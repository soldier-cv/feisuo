<?xml version="1.0" encoding="utf-8"?>
<!-- 次按钮：透明底 + 描边，避免一屏里出现太多实心绿按钮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#14161C" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="#23262F" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#242832" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/feisuo_card_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1B1E26" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/feisuo_card_stroke" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<!-- M3 Outlined Pill Button + 原生水波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/feisuo_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/feisuo_btn_secondary_disabled" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/feisuo_card_stroke" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/feisuo_btn_secondary_pressed" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/feisuo_card_stroke" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/feisuo_btn_secondary_bg" />
                    <corners android:radius="24dp" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/feisuo_card_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>

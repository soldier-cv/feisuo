<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标前景层：与桌面端 desktop/src-tauri/icons/icon.svg 同一架纸飞机。

  108x108 画布，内容全部落在中间 66x66 安全区（21~87）内 ——
  启动器会按圆形 / 圆角方形 / 方形裁切，超出安全区的部分会被切掉。
  颜色也直接沿用桌面端：深绿 #047857、暗绿 #06523C、白 #FFFFFF、亮绿 #00DC82。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 上侧机翼 -->
    <path
        android:fillColor="#FF047857"
        android:pathData="M81.64,26.36 L23.28,62.20 L44.78,56.04 Z" />
    <!-- 下侧机翼 -->
    <path
        android:fillColor="#FF06523C"
        android:pathData="M81.64,26.36 L51.96,63.22 L45.80,84.72 Z" />
    <!-- 白色折面 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M81.64,26.36 L44.78,56.04 L32.50,75.50 Z" />
    <!-- 亮绿折面 -->
    <path
        android:fillColor="#FF00DC82"
        android:pathData="M81.64,26.36 L32.50,75.50 L51.96,63.22 Z" />
</vector>

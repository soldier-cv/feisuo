<?xml version="1.0" encoding="utf-8"?>
<!-- 输入框：聚焦时描边变成品牌绿，让用户一眼看到当前在填哪一栏 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/feisuo_input" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/feisuo_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/feisuo_input" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/feisuo_input_stroke" />
        </shape>
    </item>
</selector>

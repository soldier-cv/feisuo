# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Rust
[*.rs]
indent_size = 4

# Kotlin & Gradle
[*.{kt,kts,gradle}]
indent_size = 4

# Python
[*.py]
indent_size = 4

# Windows scripts & Inno Setup
[*.{bat,cmd,ps1,iss,isl}]
end_of_line = crlf

# Markdown files may use trailing spaces for line breaks
[*.md]
trim_trailing_whitespace = false
